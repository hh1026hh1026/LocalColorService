# Local Color Service Configuration

# FFmpeg Executable Paths
FFMPEG_PATH=C:\ffmpeg_cuda\bin\ffmpeg.exe
FFPROBE_PATH=C:\ffmpeg_cuda\bin\ffprobe.exe

# Fallback FFmpeg Paths (if C:\ffmpeg_cuda\bin is missing)
FFMPEG_FALLBACK_PATH=E:\ffmpeg-2025-01-15-git-4f3c9f2f03-essentials_build\bin\ffmpeg.exe
FFPROBE_FALLBACK_PATH=E:\ffmpeg-2025-01-15-git-4f3c9f2f03-essentials_build\bin\ffprobe.exe

# Database and Storage Paths
DATA_DIR=F:\LocalColorService\data
DATABASE_URL=sqlite:///F:\LocalColorService\data\local_color.db

# OCIO Configuration Path
OCIO_CONFIG_PATH=F:\LocalColorService\configs\ocio\studio-config-v2.0.ocio

# Service Host & Port
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# V0.2 neural model adapters
ADAINT_CHECKPOINT=F:\LocalColorService\models\adaint\AiLUT-FiveK-sRGB.pth
# Optional external diffusion runner. Placeholders: {source}, {reference}, {output}, {variant}
REFERENCE_LUT_COMMAND=

# Smart scene grouping. Offline is deterministic and needs no model download.
# Set to dinov2 and point DINOV2_REPO at a local facebookresearch/dinov2 clone
# to enable semantic embeddings. Network download is disabled unless explicitly allowed.
SCENE_EMBEDDING_BACKEND=offline
DINOV2_REPO=
DINOV2_ALLOW_DOWNLOAD=0

# Face-aware rendering: the face/skin region receives a restrained percentage
# of the creative LUT while technical correction remains fully active.
FACE_SELECTIVE_RENDER=1
FACE_CREATIVE_STRENGTH=0.30
